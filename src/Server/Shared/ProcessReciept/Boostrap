-- // Services \\ --
local PlayersService = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local module = {}

function module:Init()
	-- // Cache required handlers
	local Handlers = {
		Products = {},
		Gamepasses = {}
	}

	for _, mod in pairs(script.Products:GetChildren()) do
		if mod:IsA("ModuleScript") then
			Handlers.Products[mod.Name] = require(mod)
		end
	end
	
	for _, mod in pairs(script.Gamepasses:GetChildren()) do
		if mod:IsA("ModuleScript") then
			Handlers.Gamepasses[mod.Name] = require(mod)
		end
	end

	-- // Process Receipt \\ --
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local productName = game:GetService("MarketplaceService"):GetProductInfoAsync(receiptInfo.ProductId, Enum.InfoType.Product).Name
		
		local handler = Handlers.Products[productName]

		if handler then
			return handler(receiptInfo)
		else
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	
	-- // Gamepass Purchases \\ --
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamepassId)
		local gamepassName = game:GetService("MarketplaceService"):GetProductInfoAsync(gamepassId, Enum.InfoType.GamePass).Name
		local handler = Handlers.Gamepasses[gamepassName]
		
		if handler then
			handler.execute(player)
		end
	end)
	
	PlayersService.PlayerAdded:Connect(function(player : Player)
		for _, gamepassModule in pairs(script:WaitForChild("Gamepasses"):GetChildren()) do
			local handler = require(gamepassModule)
			local gamepassId = handler.gamepassId
			local activateOnJoin = handler.activateOnJoin
			
			print(gamepassId)
			
			if activateOnJoin then
				print(gamepassModule.Name.." activates on join")
				
				local success, ownsGamepass = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gamepassId)
				end)
				
				print(success, ownsGamepass)
				
				if success and ownsGamepass then
					print("executing start")
					
					handler.execute(player)
					
					print("executing finished")
				end
			end
		end
	end)
end

return module
