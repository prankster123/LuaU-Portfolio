## Utilizes GoodSignal to create input signals easily in an organized way

-- // Services \\ --
local UserInputService = game:GetService("UserInputService")

-- // Modules \\ --
local ModulesFolder = game:GetService("ReplicatedStorage"):WaitForChild("Modules")
local GoodSignal = require(ModulesFolder:WaitForChild("Services"):WaitForChild("GoodSignal"))

-- // Module \\ --
local InputController = {}
InputController.__index = InputController

function InputController.new()
	local self = setmetatable({}, InputController)
	
	self._signals = {}

	-- RBX connections
	self._connections = {}

	-- state tracking (optional but useful if we wanted to add smth)
	self._held = {}

	self:_init()

	return self
end

function InputController:_getSignal(inputEnum)
	if not self._signals[inputEnum] then
		self._signals[inputEnum] = GoodSignal.new()
	end

	return self._signals[inputEnum]
end

function InputController:Bind(inputEnum)
	return self:_getSignal(inputEnum)
end

-- // Init \\ --
function InputController:_init()
	-- InputBegan
	table.insert(self._connections,
		UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end

			local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
			self._held[key] = true

			local signal = self._signals[key]
			if signal then
				signal:Fire(true, input) -- true = began
			end
		end)
	)

	-- InputEnded
	table.insert(self._connections,
		UserInputService.InputEnded:Connect(function(input)
			local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
			self._held[key] = false

			local signal = self._signals[key]
			if signal then
				signal:Fire(false, input) -- false = ended
			end
		end)
	)
end

function InputController:IsHeld(inputEnum)
	return self._held[inputEnum] or false
end

-- // Disconnect one RBX connection \\ --
function InputController:Disconnect(conn)
	for i, v in ipairs(self._connections) do
		if v == conn then
			v:Disconnect()
			table.remove(self._connections, i)
			break
		end
	end
end

-- // Full cleanup \\ --
function InputController:DisconnectAll()
	-- RBX connections
	for _, conn in ipairs(self._connections) do
		conn:Disconnect()
	end
	table.clear(self._connections)

	-- signals
	for _, signal in pairs(self._signals) do
		signal:DisconnectAll()
	end

	table.clear(self._signals)
	table.clear(self._held)
end

return InputController
