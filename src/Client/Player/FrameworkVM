-- // Springs \\ --
local CamShakeSpring = SpringModule.create(12, 25, 1.5, 10)
local VMShakePosSpring = SpringModule.create(12, 25, 1.5, 10)
local VMShakeRotSpring = SpringModule.create(12, 25, 1.5, 5)
local VMBobPosSpring = SpringModule.create(7, 5, 0.75, 15)
local VMBobRotSpring = SpringModule.create(7, 5, 0.75, 15)
local VMSwayRotSpring = SpringModule.create(12, 15, 0.75, 15)
local VMSwayPosSpring = SpringModule.create(12, 15, 0.75, 15)

-- // Math \\ --
local abs = math.abs
local clamp = math.clamp
local rad = math.rad
local pi = math.pi

local module = {
	Framework = {
		-- // General \\ --
		Viewmodel = nil :: Model;
		WeaponModel = nil :: Model;
		EquippedWeapon = nil :: Model;
		Animations = {
			FirstPerson = {
				Idle = nil;
				Sprinting = nil;
				Attacks = {
					Light = {};
					Heavy = {};
					PlayInOrder = true;
					LastLightAnim = nil;
					LastHeavyAnim = nil;
					CurrentAnimationPlaying = nil;
				};
				Block = nil
			},
		};
		
		Walkspeed = {
			Base = 0;
			Heavy = {
				Speed = 0;
				Duration = 0;
			}
		};
		
		Input = {
			LeftClick = nil;
			RightClick = nil;
			Sprint = nil;
			Block = nil;
		};
		
		Cooldowns = {
			LastAttack = {
				Light = 0,
				Heavy = 0,
			};
			
			LastBlock = 0;
			
			Time = {
				Light = 0;
				Heavy = 0;
			};
			
			IsAttacking = false;
			IsBlocking = false;
		};
		
